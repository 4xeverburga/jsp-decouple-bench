# BookShopWeb — setup template.
#
# Copy to `.env` next to this file. `.env` is TRACKED in the bench on purpose:
# its values are synthetic and deterministic. NEVER put real secrets in it.
#
# They reach the app through `compose.yaml`; the case flows read the accounts
# below from the process environment, which `cli.capture` / `cli.score` fill
# from this file.
#
# Host ports are NOT configured here: `compose.yaml` publishes
# `${APP_HTTP_PORT:-8093}`, which the driver overrides per run.

# Database (also the MySQL service's own bootstrap settings). The dump
# creates `bookshopdb` itself.
BSW_DB_USER=root
BSW_DB_PASSWORD=CHANGE_ME
BSW_DB_NAME=bookshopdb

# The accounts the flows log in with. They are the ones the tree's own dump
# seeds, whose password is an unsalted MD5 of 123.
BSW_ADMIN_USER=user1
BSW_ADMIN_PASSWORD=CHANGE_ME
BSW_CUSTOMER_USER=user4
BSW_CUSTOMER_PASSWORD=CHANGE_ME

# Traces. The OpenTelemetry Java agent in `front` is configured only through
# these; `collector` (see otel-collector.yaml) writes what it receives to the
# `traces` volume.
OTEL_SERVICE_NAME=bookshopweb
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
