{
  "sample": "mamute",
  "case": "answer-flow__negative-karma-earns-nothing",
  "e2e": {
    "routes": [
      "/sign-up",
      "/ask",
      "/logout",
      "/login",
      "/{question.id}-{sluggedTitle}",
      "/answer/{question.id}"
    ],
    "locale": "en-US",
    "timezone_id": "UTC",
    "viewport": {
      "width": 1280,
      "height": 800
    },
    "auth": "mixed",
    "auth_notes": "The author signs up in-flow with fixed credentials and asks. The answering actor is the seeded moderator, credentials from the sample .env only.",
    "credentials": "env:MAMUTE_ADMIN_USER,MAMUTE_ADMIN_PASSWORD",
    "requires_db_reset": true,
    "artifacts": [
      "question_url",
      "dom_before",
      "dom_after",
      "answers_count_before",
      "answers_count_after",
      "answer_visible_after"
    ]
  },
  "db": {
    "tables": [
      {
        "name": "Users",
        "key_columns": [
          "id"
        ],
        "ignore_columns": [
          "createdAt",
          "lastUpvote",
          "nameLastTouchedAt"
        ]
      },
      {
        "name": "LoginMethod",
        "key_columns": [
          "id"
        ],
        "ignore_columns": []
      },
      {
        "name": "Question",
        "key_columns": [
          "id"
        ],
        "ignore_columns": [
          "createdAt",
          "lastUpdatedAt"
        ]
      },
      {
        "name": "QuestionInformation",
        "key_columns": [
          "id"
        ],
        "ignore_columns": [
          "createdAt",
          "ip"
        ]
      },
      {
        "name": "Tag",
        "key_columns": [
          "id"
        ],
        "ignore_columns": [
          "createdAt"
        ]
      },
      {
        "name": "QuestionInformation_Tag",
        "key_columns": [
          "QuestionInformation_id",
          "tags_id"
        ],
        "ignore_columns": []
      },
      {
        "name": "Watcher",
        "key_columns": [
          "id"
        ],
        "ignore_columns": [
          "createdAt"
        ]
      },
      {
        "name": "Question_Watchers",
        "key_columns": [
          "Question_id",
          "watchers_id"
        ],
        "ignore_columns": []
      },
      {
        "name": "Answer",
        "key_columns": [
          "id"
        ],
        "ignore_columns": [
          "createdAt",
          "lastUpdatedAt"
        ]
      },
      {
        "name": "AnswerInformation",
        "key_columns": [
          "id"
        ],
        "ignore_columns": [
          "createdAt",
          "ip"
        ]
      },
      {
        "name": "Question_Interactions",
        "key_columns": [
          "Question_id",
          "userInteractions_id"
        ],
        "ignore_columns": []
      },
      {
        "name": "ReputationEvent",
        "key_columns": [
          "id"
        ],
        "ignore_columns": [
          "date"
        ]
      }
    ],
    "notes": "seed.sql sets the seeded moderator's (Users.id 1001, the only user at first boot) karma to -5, a state downvotes produce in normal use. hasKarma() is then false: the answer is saved with its ReputationEvent, but the moderator's karma is not raised, so Users shows no karma update for it. UserSession is excluded as auth plumbing."
  }
}
