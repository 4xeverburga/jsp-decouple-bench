[
  {
    "sample": "mamute",
    "task_type": "decouple_slice",
    "version": 1,
    "prompt": "Users need to post an answer to a question. The answer form posts to a server-rendered page today; make it post to a JSON endpoint and update the page from the response. Everything users can do now must still work.",
    "bindings": {
      "stack": {
        "adapter": "compose@1"
      },
      "browser": {
        "adapter": "playwright@1"
      },
      "db": {
        "adapter": "mysql@1",
        "options": {
          "service": "db",
          "user": "root",
          "password": "",
          "database": "mamute_development"
        }
      }
    },
    "scope": {
      "cases": [
        "answer-flow__answer-appears"
      ],
      "routes": [
        "/sign-up",
        "/ask",
        "/logout",
        "/login",
        "/{question.id}-{sluggedTitle}",
        "/answer/{question.id}"
      ]
    },
    "name": "answer-flow"
  },
