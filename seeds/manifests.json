  {
    "sample": "openclinica",
    "task_type": "decouple_slice",
    "version": 1,
    "prompt": "Study staff need to add a subject to a study and see it in the subject list. The form posts to a server-rendered page today; make it post to a JSON endpoint and refresh the list from the response. Everything staff can do now must still work.",
    "bindings": {
      "stack": {
        "adapter": "compose@1"
      },
      "browser": {
        "adapter": "playwright@1"
      },
      "db": {
        "adapter": "shell@1",
        "options": {
          "cmd": "podman exec -i openclinica-pg psql -U clinica -d openclinica -X -A -F$'\\t' -P footer=off -P null=NULL",
          "list_tables_sql": "SELECT tablename FROM pg_tables WHERE schemaname='public' ORDER BY tablename"
        }
      }
    },
    "scope": {
      "cases": [
        "subject-flow__subject-creation"
      ],
      "routes": [
        "/",
        "/j_spring_security_check",
        "/AddNewSubject",
        "/ListStudySubjects"
      ]
    },
    "name": "subject-flow"
  }
]
