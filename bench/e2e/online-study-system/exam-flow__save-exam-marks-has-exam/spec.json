{
  "task": "exam-flow",
  "behavior": "save-exam-marks-has-exam",
  "routes": [
    "/login",
    "/student/selectedCourse",
    "/student/startStudy",
    "/student/backPeriod",
    "/student/startExam",
    "/student/saveExam"
