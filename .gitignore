# generated output — never a source of truth
out/

# secrets. The root .env is never tracked. A sample's env/.env is tracked
# because its values are synthetic (see src/samples/<sample>/env/).
.env
!src/samples/*/env/.env

# python
__pycache__/
*.pyc
.venv/

# sqlite sidecars (bench.db itself IS tracked)
bench.db-wal
bench.db-shm
