# generated output — never a source of truth
out/
# a hand-made backup of out/, kept beside it
out-old/

# secrets. The root bench.env is never tracked (nor a stray root .env). A
# sample's env/.env is tracked because its values are synthetic (see
# src/samples/<sample>/env/).
bench.env
.env
!src/samples/*/env/.env

# python
__pycache__/
*.pyc
.venv/

# sqlite sidecars (bench.db itself IS tracked)
bench.db-wal
bench.db-shm
