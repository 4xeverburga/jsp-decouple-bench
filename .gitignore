bench/MANIFEST.sha256

# Per-sample eval env: .env is TRACKED (synthetic, deterministic bench
# credentials — reproducibility across researchers matters more than
# secrecy here).  NEVER put real secrets (OAuth keys, API tokens) in a
# tracked .env — those belong in gitignored files only.
# openclinica still follows the old gitignored-.env convention (see its
# AGENTS.md) — flip it deliberately before un-ignoring.
environments/openclinica/.env
__pycache__/
*.pyc
