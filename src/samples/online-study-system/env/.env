# Online Study System — the sample's credentials and trace settings.
#
# TRACKED on purpose (see the bench's .gitignore): the values are synthetic
# and deterministic, so a stack boots with the same accounts every time.
# NEVER put a real secret in a tracked .env.
#
# They reach the app through `compose.yaml`; the case flows read the accounts
# below from the process environment, which `cli.capture` / `cli.score` fill
# from this file.
#
# Host ports are NOT configured here: `compose.yaml` publishes
# `${APP_HTTP_PORT:-8091}`, which the driver overrides per run.

# Database (also the MySQL service's own bootstrap settings).
OSS_DB_USER=root
OSS_DB_PASSWORD=root
OSS_DB_NAME=online_study_system

# The accounts the flows log in with. They are the ones the tree's own dump
# seeds, whose password is a salted SHA-1 of 123.
OSS_ADMIN_USER=admin
OSS_ADMIN_PASSWORD=123
OSS_TEACHER_USER=李老师
OSS_TEACHER_PASSWORD=123
OSS_STUDENT_USER=小明
OSS_STUDENT_PASSWORD=123
OSS_STUDENT2_USER=小红
OSS_STUDENT2_PASSWORD=123

# Traces. The OpenTelemetry Java agent in `front` is configured only through
# these; `collector` (see otel-collector.yaml) writes what it receives to the
# `traces` volume.
OTEL_SERVICE_NAME=online-study-system
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
