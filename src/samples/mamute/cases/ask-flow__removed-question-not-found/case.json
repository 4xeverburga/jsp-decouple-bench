{
  "sample": "mamute",
  "case": "ask-flow__removed-question-not-found",
  "e2e": {
    "routes": [
      "/sign-up",
      "/ask",
      "/logout",
      "/login",
      "/{question.id}-{sluggedTitle}",
      "/{flaggableType}/{flaggableId}/mark"
    ],
    "locale": "en-US",
    "timezone_id": "UTC",
    "viewport": {
      "width": 1280,
      "height": 800
    },
    "auth": "mixed",
    "auth_notes": "The author signs up in-flow with fixed credentials. The flagging actor is the seeded moderator, credentials from the sample .env only; the visitor is logged out.",
    "credentials": "env:MAMUTE_ADMIN_USER,MAMUTE_ADMIN_PASSWORD",
    "requires_db_reset": true,
    "artifacts": [
      "question_url",
      "status_after",
      "dom_after"
    ]
  },
  "db": {
    "tables": [
      {
        "name": "Users",
        "key_columns": [
          "id"
        ],
        "ignore_columns": [
          "createdAt",
          "lastUpvote",
          "nameLastTouchedAt"
        ]
      },
      {
        "name": "LoginMethod",
        "key_columns": [
          "id"
        ],
        "ignore_columns": []
      },
      {
        "name": "Question",
        "key_columns": [
          "id"
        ],
        "ignore_columns": [
          "createdAt",
          "lastUpdatedAt"
        ]
      },
      {
        "name": "QuestionInformation",
        "key_columns": [
          "id"
        ],
        "ignore_columns": [
          "createdAt",
          "ip"
        ]
      },
      {
        "name": "Tag",
        "key_columns": [
          "id"
        ],
        "ignore_columns": [
          "createdAt"
        ]
      },
      {
        "name": "QuestionInformation_Tag",
        "key_columns": [
          "QuestionInformation_id",
          "tags_id"
        ],
        "ignore_columns": []
      },
      {
        "name": "Watcher",
        "key_columns": [
          "id"
        ],
        "ignore_columns": [
          "createdAt"
        ]
      },
      {
        "name": "Question_Watchers",
        "key_columns": [
          "Question_id",
          "watchers_id"
        ],
        "ignore_columns": []
      },
      {
        "name": "Question_Interactions",
        "key_columns": [
          "Question_id",
          "userInteractions_id"
        ],
        "ignore_columns": []
      },
      {
        "name": "ReputationEvent",
        "key_columns": [
          "id"
        ],
        "ignore_columns": [
          "date"
        ]
      },
      {
        "name": "Flag",
        "key_columns": [
          "id"
        ],
        "ignore_columns": []
      },
      {
        "name": "Question_Flags",
        "key_columns": [
          "Question_id",
          "flags_id"
        ],
        "ignore_columns": []
      }
    ],
    "notes": "expected_delta.json is captured from the pristine app (never hand-written). Table/column names confirmed empirically by diffing a full dump during capture (join tables use tags_id/watchers_id, not Tag_id/Watcher_id). UserSession is deliberately excluded: auth plumbing, volatile by nature \u2014 the independent_frontend gate allows re-implementing it. ignore_columns are stripped from inserted/deleted rows and update comparisons by the capture tooling."
  }
}
