# Mamute — local setup template.
#
# NOTE: `.env` itself is TRACKED in this repo on purpose (see .gitignore):
# its values are synthetic and deterministic, so a bare checkout boots with
# the same accounts every time.  NEVER put real secrets (OAuth keys, API
# tokens) in a tracked .env — those belong in gitignored files only.
#
# These values reach the app through `compose.yaml`; the end-to-end scripts
# read them from the environment — never hardcode them.
#
# Host ports are NOT configured here: `compose.yaml` publishes
# `${APP_HTTP_PORT:-8090}`, which can be overridden for a checkout that must
# not use the default. The database publishes nothing: it is reached from
# inside its own network.

# Admin account the e2e flows log in with. Mamute seeds a moderator at
# first boot; the one-shot `bootstrap` service rotates it to this password.
MAMUTE_ADMIN_USER=admin@mamute.dev
MAMUTE_ADMIN_PASSWORD=CHANGE_ME

# Traces. The OpenTelemetry Java agent in `front` is configured only through
# these; `collector` (see otel-collector.yaml) writes what it receives to
# the `traces` volume. Same values as the tracked .env.
OTEL_SERVICE_NAME=mamute
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
