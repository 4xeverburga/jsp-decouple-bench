# Agent toolbox: the JDK 8, Maven, Tomcat 9 and psql the OpenClinica WAR
# runs on.
#
# No container runtime in here: the database is a sidecar. inspect_swe copies
# the agent CLI binary in at run time, so the agent is not installed here.
FROM maven:3.8.6-openjdk-8

ARG TOMCAT_VERSION=9.0.98
RUN wget -qO- https://archive.apache.org/dist/tomcat/tomcat-9/v${TOMCAT_VERSION}/bin/apache-tomcat-${TOMCAT_VERSION}.tar.gz \
      | tar -xz -C /opt \
    && ln -s /opt/apache-tomcat-${TOMCAT_VERSION} /opt/tomcat
ENV CATALINA_HOME=/opt/tomcat
ENV JAVA_HOME=/usr/local/openjdk-8

# The agent's shell is given a PATH of /usr/local/bin:/usr/bin:/bin, which this
# ENV does not reach — the base image leaves the JDK tools out of it, so they
# answer "command not found" otherwise. (`mvn` resolves either way, and the WAR
# will not build without `java`/`javac`/`jar`.)
RUN for tool in java javac jar jarsigner javadoc javap jcmd jdb jps \
      jrunscript jstack keytool; do \
      ln -sf "/usr/local/openjdk-8/bin/$tool" "/usr/local/bin/$tool"; \
    done

# A postgres client. The app's database is a sidecar on this network, and
# reading its schema is part of understanding what a flow persists.
#
# Two traps, both fixed here: the image ships stale package lists (so it asks
# for versions that are gone), and bullseye-security indexes versions the
# mirror no longer carries (404). The client comes from the main repo, which
# still has it, and it is only ever a client.
RUN rm -rf /var/lib/apt/lists/* \
 && sed -i '/debian-security/d' /etc/apt/sources.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client \
 && rm -rf /var/lib/apt/lists/*
RUN ln -sf /usr/bin/psql /usr/local/bin/psql

WORKDIR /workspace

# Dependency-cache and compile state, from the pin's own poms: the build
# context is the sample tree (see solve.yaml), the same one the scoring image
# builds from. Without this layer every solve paid the whole reactor's cold
# download before the agent could compile anything.
#
# Nothing copied here is what the agent reads: at run time the checkout is
# bind-mounted over /workspace, so only `~/.m2` survives into the solve.
#
# Not `dependency:go-offline`: it asks every repository the poms declare for
# every artifact of every plugin — far more work than the build it warms (it
# had not finished after thirteen minutes on the mamute sample). The
# `package` below is the build the agent has to run anyway, so it resolves
# exactly that set. The pass before the sources are copied only warms the
# plugins, and on this reactor it stops at the JAXB plugin, which needs
# `ws/src/main/webapp/WEB-INF/schemas` — hence `|| true`: the `package` below
# is the one that has to succeed.
#
# Last on purpose: every layer above this one would invalidate it, and a
# re-download is minutes of silence (`-q`).
COPY pom.xml ./
COPY core/pom.xml core/
COPY web/pom.xml web/
COPY ws/pom.xml ws/
RUN mvn -B -q -DskipTests compile || true

COPY . .
RUN mvn -B -q -DskipTests \
      -Dmaven.buildNumber.allowNullScm=true \
      -DdbType=postgres \
      -DdbUser=clinica \
      -DdbPass=clinica \
      -Ddb=openclinica \
      -DdbPort=5432 \
      -DdbHost=db \
      -DWEBAPP=OpenClinica \
      -DWEBAPP.lower=openclinica \
      -Dcatalina.home=/opt/tomcat \
      clean package
