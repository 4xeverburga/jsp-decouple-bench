# OpenClinica — the sample's credentials and trace settings.
#
# TRACKED on purpose (see the bench's .gitignore): the values are synthetic
# and deterministic, so a stack boots with the same accounts every time.
# NEVER put a real secret in a tracked .env.
#
# They reach the app through `compose.yaml`; the case flows read the admin
# pair from the process environment, which `cli.capture` / `cli.score` fill
# from this file. Keep these values alphanumeric: entrypoint.sh writes the
# database ones into a properties file with sed, and the admin password is
# hashed by the bootstrap script.
#
# Host ports are NOT configured here: `compose.yaml` publishes
# `${APP_HTTP_PORT:-8092}`, which the driver overrides per run.

# Database (also the PostgreSQL service's own bootstrap settings).
OPENCLINICA_DB_USER=clinica
OPENCLINICA_DB_PASSWORD=bench-openclinica-db-4x2k
OPENCLINICA_DB_NAME=openclinica

# The seeded account the flows log in with. Liquibase seeds `root`; the
# one-shot `bootstrap` service rotates it to this password.
OPENCLINICA_ADMIN_USER=root
OPENCLINICA_ADMIN_PASSWORD=bench-openclinica-admin-7t3q

# Traces. The OpenTelemetry Java agent in `front` is configured only through
# these; `collector` (see otel-collector.yaml) writes what it receives to the
# `traces` volume.
OTEL_SERVICE_NAME=openclinica
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
