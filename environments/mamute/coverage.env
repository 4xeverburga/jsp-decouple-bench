# Per-sample coverage configuration — consumed by scripts/measure-coverage.sh
# and scripts/run_flow.py. Everything sample-specific about coverage lives here;
# the scripts stay generic.
#
# COVERAGE_SERVICE        compose service that runs the app (gets the agent)
# COVERAGE_BASE_URL       externally reachable URL of the app on the host
# COVERAGE_CONTAINER_CLASSFILES  compiled classes inside the app container
# COVERAGE_SOURCEFILES    Java sources on the host, relative to the bench root
# COVERAGE_ENV_FILE       sample .env with the credentials the flows read
COVERAGE_SERVICE=app
COVERAGE_AGENT_PORT=6300
COVERAGE_BASE_URL=http://localhost:8090
COVERAGE_CONTAINER_CLASSFILES=/workspace/src/main/webapp/WEB-INF/classes
COVERAGE_SOURCEFILES=../mamute/src/main/java
COVERAGE_ENV_FILE=environments/mamute/.env
