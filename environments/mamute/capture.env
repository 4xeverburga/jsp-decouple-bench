# Per-sample capture configuration — consumed by scripts/capture_delta.py.
# Everything sample-specific about golden-delta capture lives here.
#
# CAPTURE_BASE_URL        externally reachable URL of the app on the host
# CAPTURE_ENV_FILE        sample .env with the credentials the flows read
# CAPTURE_DB_CMD          shell command that reads the SQL query from stdin
#                         and prints a header line plus tab-separated rows
#                         (mysql --batch / psql -A -F$'\t').
# CAPTURE_LIST_TABLES_SQL query listing all table names (first output column)
CAPTURE_BASE_URL=http://localhost:8090
CAPTURE_ENV_FILE=environments/mamute/.env
CAPTURE_DB_CMD=sg docker -c "docker compose -f $BENCH/environments/mamute/compose.yml exec -T db mysql -uroot mamute_development --batch"
CAPTURE_LIST_TABLES_SQL=SHOW TABLES
