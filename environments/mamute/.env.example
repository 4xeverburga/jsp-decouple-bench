# Mamute sample — eval environment template.
#
# Copy to .env (gitignored) and fill in; the harness injects these into
# every e2e flow. A fresh clone must reach a green eval with only:
#   cp environments/mamute/.env.example environments/mamute/.env
#   make setup SAMPLE=mamute
#   make eval  SAMPLE=mamute TASK=<task> AGENT=pristine
#
# NEVER hardcode these values in spec.json / flow.py / compose.yml —
# read them from the environment (harness-provided).

# Admin account the e2e flows log in with. Mamute seeds a moderator at
# first boot; the sample's setup bootstrap rotates it to this password.
MAMUTE_ADMIN_USER=admin@mamute.dev
MAMUTE_ADMIN_PASSWORD=CHANGE_ME

# Ports the sample's compose stack publishes (keep disjoint from other
# samples on the same machine).
MAMUTE_HTTP_PORT=8090
MAMUTE_DB_PORT=5434
