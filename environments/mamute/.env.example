# Mamute sample — eval environment template.
#
# NOTE: `.env` itself is TRACKED in this repo (see .gitignore): the values
# are synthetic, deterministic bench credentials so every researcher gets
# an identical environment.  NEVER put real secrets (OAuth keys, API
# tokens) in a tracked .env — those belong in gitignored files only.
#
# The harness injects these into every e2e flow; spec.json / flow.py /
# compose.yml read them from the environment — never hardcode them.

# Admin account the e2e flows log in with. Mamute seeds a moderator at
# first boot; the sample's setup bootstrap rotates it to this password.
MAMUTE_ADMIN_USER=admin@mamute.dev
MAMUTE_ADMIN_PASSWORD=CHANGE_ME

# Ports the sample's compose stack publishes (keep disjoint from other
# samples on the same machine).
MAMUTE_HTTP_PORT=8090
MAMUTE_DB_PORT=5434
