# Per-sample coverage configuration — consumed by scripts/measure-coverage.sh
# and scripts/run_flow.py. Everything sample-specific about coverage lives
# here; the scripts stay generic.
#
# COVERAGE_STACK_MODE     compose | tomcat-local
#   compose: docker compose stack; agent injected via the coverage override
# COVERAGE_SERVICE        compose service that runs the app (compose mode)
# COVERAGE_BASE_URL       externally reachable URL of the app on the host
# COVERAGE_CONTAINER_CLASSFILES  compiled classes inside the app container
#                                (compose mode; copied out with compose cp)
# COVERAGE_SOURCEFILES    Java sources on the host, relative to the bench root
#                         (colon-separated list is supported)
# COVERAGE_ENV_FILE       sample .env with the credentials the flows read
COVERAGE_STACK_MODE=compose
COVERAGE_SERVICE=app
COVERAGE_AGENT_PORT=6302
COVERAGE_BASE_URL=http://localhost:8091/Examination_System
COVERAGE_CONTAINER_CLASSFILES=/usr/local/tomcat/webapps/Examination_System/WEB-INF/classes
COVERAGE_SOURCEFILES=../Online_Study_System/src/main/java
COVERAGE_ENV_FILE=environments/online-study-system/.env
