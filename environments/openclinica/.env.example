# OpenClinica sample — eval environment template.
#
# NOTE: `.env` itself is TRACKED in this repo (see .gitignore): the values
# are synthetic, deterministic bench credentials so every researcher gets
# an identical environment.  NEVER put real secrets (OAuth keys, API
# tokens) in a tracked .env — those belong in gitignored files only.
# The scripts in scripts/ read .env directly.

# Admin account the e2e flows log in with. Upstream Liquibase seeds
# root/12345678 (public seed, tracked in the openclinica repo); the
# bootstrap script rotates it to this password after every fresh DB.
OPENCLINICA_ADMIN_USER=root
OPENCLINICA_ADMIN_PASSWORD=CHANGE_ME

# Ports (keep disjoint from other samples on the same machine).
OPENCLINICA_HTTP_PORT=8089
