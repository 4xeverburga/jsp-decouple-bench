# Per-sample coverage configuration — consumed by scripts/measure-coverage.sh
# and scripts/run_flow.py. Everything sample-specific about coverage lives here;
# the scripts stay generic.
#
# COVERAGE_STACK_MODE     compose | tomcat-local
#   compose: docker compose stack; agent injected via the coverage override
#   tomcat-local: app runs in a host Tomcat; agent injected via setenv.sh and
#                 the stack is (re)started by the script
# COVERAGE_SERVICE        compose service that runs the app (compose mode)
# COVERAGE_BASE_URL       externally reachable URL of the app on the host
# COVERAGE_CONTAINER_CLASSFILES  compiled classes inside the app container
#                                (compose mode; copied out with compose cp)
# COVERAGE_HOST_CLASSFILES       compiled classes on the host (tomcat-local)
# COVERAGE_SOURCEFILES    Java sources on the host, relative to the bench root
#                         (colon-separated list is supported)
# COVERAGE_ENV_FILE       sample .env with the credentials the flows read
# COVERAGE_TOMCAT_HOME    Tomcat instance (tomcat-local mode)
# COVERAGE_RESET_CMD      pristine-reset command before each test
#                         (tomcat-local mode; runs from the bench root)
COVERAGE_STACK_MODE=tomcat-local
COVERAGE_AGENT_PORT=6301
COVERAGE_BASE_URL=http://localhost:8089/OpenClinica
COVERAGE_HOST_CLASSFILES=/home/ever/tools/apache-tomcat-oc/webapps/OpenClinica/WEB-INF/classes
COVERAGE_SOURCEFILES=../openclinica/core/src/main/java:../openclinica/web/src/main/java
COVERAGE_ENV_FILE=environments/openclinica/.env
COVERAGE_TOMCAT_HOME=/home/ever/tools/apache-tomcat-oc
COVERAGE_RESET_CMD=./environments/openclinica/scripts/reset-pristine.sh
