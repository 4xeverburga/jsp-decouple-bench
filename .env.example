# Every value here is REQUIRED: settings.py has no defaults and fails on a
# missing key. Copy this template to `.env` once. `.env` is untracked, and it
# is the only source of these parameters — the shell environment is not read.
#
# Per-run inputs are NOT here, because they change from run to run and the
# driver sets them on each invocation:
#   BENCH_CHECKOUT    the tree under test
#   BENCH_BASE_URL    the URL the running stack publishes the app on
#   BENCH_SAMPLE_ENV  the sample's own env folder
#
# --- determinism. The goldens were captured with these; do not change them
# casually, or every case will differ for a reason that is not a bug. ------
BENCH_LOCALE=en-US
BENCH_TIMEZONE_ID=UTC
BENCH_VIEWPORT_WIDTH=1280
BENCH_VIEWPORT_HEIGHT=800
# How long a flow waits for the app to render a result before it fails.
BENCH_CASE_TIMEOUT_MS=60000

# --- the browser a case is played in -------------------------------------
BENCH_HEADLESS=1

# --- the stack a case is scored on ---------------------------------------
# The first build downloads the whole dependency set into an empty ~/.m2, so
# a build gets its own budget; after it, the services still have to turn
# healthy.
STACK_BUILD_TIMEOUT_S=1800
STACK_HEALTHY_TIMEOUT_S=600
# Readiness is observed by polling, because `compose up --wait` fails on a
# one-shot service that exits 0. POLL is each round; REPORT is how often a
# stack that is still starting says what it is waiting for.
STACK_POLL_INTERVAL_S=3
STACK_REPORT_INTERVAL_S=15
STACK_PROJECT_PREFIX=bench-

# --- the agent that runs the solve ---------------------------------------
# AGENT names an implementation in src/agents/registry.py. CLI agents use
# the model and version below as their wire model and installed version.
# For native react they are recorded labels only: it uses
# BENCH_ANSWER_MODEL directly. opencode has run a whole slice end to end;
# react has done only the dummy-file smoke test so far.
#
#   react     —          —            (inspect_ai 0.3.286 provides it)
#   opencode  1.19.5     opencode-go/deepseek-v4.1-flash
#   codex     <pin>      gpt-5-codex
#   claude    <pin>      claude-sonnet-4-5
#   gemini    <pin>      gemini-2.5-pro
#
# Native react installs nothing and asks no bridge, so both labels are
# free-form: the run records them and never uses them.
#   --agent react --agent-model none --agent-version none
#
# A CLI version must know its wire model before it can send a request.
# opencode 2.x starts a managed service that never comes up in a bare
# sandbox, hence 1.19.5. For all agents, BENCH_ANSWER_MODEL is the model
# that answers.
AGENT=opencode
AGENT_MODEL=opencode-go/deepseek-v4.1-flash
AGENT_VERSION=1.19.5

# --- the model that answers, and the variables its provider reads --------
# BENCH_ANSWER_MODEL generates the tokens and is what a score is attributed
# to. AGENT_MODEL is a CLI wire name or, for native react, a recorded label.
#
# BENCH_MODEL_ENV names the environment variables that provider reads, and
# each one must be set below; an empty value means the model needs none.
#   openai/gpt-5                  OPENAI_API_KEY
#   anthropic/claude-sonnet-4-5   ANTHROPIC_API_KEY
#   google/gemini-2.5-pro         GOOGLE_API_KEY
#   openrouter/...                OPENROUTER_API_KEY
#   openai-api/<service>/<model>  <SERVICE>_API_KEY + <SERVICE>_BASE_URL
#   mockllm/model                 (none)
# A credential here is a real secret, read from this untracked file, so the
# template keeps placeholders.
BENCH_MODEL_ENV=OPENCODE_GO_API_KEY OPENCODE_GO_BASE_URL
BENCH_ANSWER_MODEL=openai-api/opencode-go/deepseek-v4.1-flash
OPENCODE_GO_API_KEY=oc_sk_replace_me
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1

# --- the model the score phase is labelled with. It answers nothing, but
# Inspect requires one, and mockllm makes that explicit in the log. -------
BENCH_SCORE_MODEL=mockllm/model
