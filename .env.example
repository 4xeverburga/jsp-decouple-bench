# Every value here is REQUIRED: config.py has no defaults and fails on a
# missing key. Copy to .env and edit. The shell environment is not read.
# NEVER put real secrets here — sample credentials belong in
# <sample-checkout>/.env (untracked).

# --- logging ---
# Progress goes to stderr (stdout stays the run_id). DEBUG adds the output
# of quiet introspection calls: compose ps/config, db dumps, exec.
BENCH_LOG_LEVEL=INFO
# How often a running child (agent session, compose build) says it is alive,
# and how often a stack that is still starting reports its service statuses.
BENCH_HEARTBEAT_S=15

# --- storage (relative to the repo root, or absolute) ---
BENCH_DB=bench.db
BENCH_SEEDS_DIR=seeds
BENCH_OUT_DIR=out

# --- sample / stack ---
BENCH_COMPOSE_FILE=compose.yaml
BENCH_SAMPLE_ENV_FILE=.env
BENCH_COMPOSE_PROJECT_PREFIX=bench-
BENCH_DOCKER=docker
BENCH_COMPOSE=compose
# A build is not a start: a cold dependency fetch takes as long as the
# network takes, so the compile gets its own budget.
STACK_BUILD_TIMEOUT_S=2400
STACK_UP_TIMEOUT_S=900

# `compose up --wait` exits 1 when a one-shot service exits (0), so the
# adapter observes readiness itself: poll interval and per-probe timeout
STACK_POLL_INTERVAL_S=2
STACK_PROBE_TIMEOUT_S=5
# 1 = do not tear the stack down after a gate (debugging)
KEEP_STACK=0

# host ports are allocated per run from this range
BENCH_PORT_START=8300
BENCH_PORT_END=8499

# --- determinism (goldens are captured with these; do not change casually) ---
BENCH_LOCALE=en-US
BENCH_TIMEZONE_ID=UTC
BENCH_VIEWPORT_WIDTH=1280
BENCH_VIEWPORT_HEIGHT=800
# how long a flow waits for the app to render a result before the case fails
BENCH_CASE_TIMEOUT_MS=30000

# --- browser ---
BENCH_BROWSER=chromium
BENCH_HEADLESS=1

# --- agent harness ---
# The agent is passed on every run (the prompt arrives on stdin):
#   make task ... HARNESS=opencode-ds-flash-max \
#                 HARNESS_CMD='opencode run --model provider/model#max "$$(cat)"'
# HARNESS is only the label recorded with the run, so name it after the model
# and its effort. Effort is the model's variant — --model provider/model#max
# (low | default | high | max); no variant means the CLI default. Through
# make, "$(cat)" is written "$$(cat)" so make does not expand it.
BENCH_HARNESS_TIMEOUT_S=3600
# examples:
#   HARNESS=command HARNESS_CMD=true
#   HARNESS=claude-code HARNESS_CMD='claude -p'
#   HARNESS=opencode-ds-flash-max HARNESS_CMD='/opt/opencode run --model opencode-go/deepseek-v4.1-flash#max "$$(cat)"'

# --- trace_similarity: stays "pending" until an oracle is configured ---
BENCH_TRACE_ORACLE=none
BENCH_TRACE_ORACLE_CMD=
