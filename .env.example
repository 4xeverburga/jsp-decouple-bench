# Every parameter below is REQUIRED: settings.py has no defaults and fails on
# a missing key. Copy this template to `.env` once. `.env` is untracked, and it
# is the only source of these parameters — the shell environment is not read.
# A credential is required only if a profile you run names it (see the
# `tasks-config.yaml` profiles below, and `python main.py manifests`).
#
# Per-run inputs are NOT here, because they change from run to run and the
# driver sets them on each invocation:
#   BENCH_CHECKOUT    the tree under test
#   BENCH_SAMPLE_ENV  the sample's own env folder
# Nor is the address a stack publishes: every stack picks a free host port
# of its own, so stacks of the same sample can run side by side.
#
# --- determinism. The goldens were captured with these; do not change them
# casually, or every case will differ for a reason that is not a bug. ------
BENCH_LOCALE=en-US
BENCH_TIMEZONE_ID=UTC
BENCH_VIEWPORT_WIDTH=1280
BENCH_VIEWPORT_HEIGHT=800
# How long a flow waits for the app to render a result before it fails.
BENCH_CASE_TIMEOUT_MS=60000

# --- the browser a case is played in -------------------------------------
BENCH_HEADLESS=1

# --- the stack a case is scored on ---------------------------------------
# The first build downloads the whole dependency set into an empty ~/.m2, so
# a build gets its own budget; after it, the services still have to turn
# healthy.
STACK_BUILD_TIMEOUT_S=1800
STACK_HEALTHY_TIMEOUT_S=600
# Readiness is observed by polling, because `compose up --wait` fails on a
# one-shot service that exits 0. POLL is each round; REPORT is how often a
# stack that is still starting says what it is waiting for.
STACK_POLL_INTERVAL_S=3
STACK_REPORT_INTERVAL_S=15
STACK_PROJECT_PREFIX=bench-
# Another process can take the free port a stack picked before `up` binds
# it; the stack then picks again, at most this many times.
STACK_PORT_ATTEMPTS=5
# Stacks up at once on this host, every bench process together. Each one is
# a JVM and a database: size it to the host's memory, not its patience.
STACK_MAX_LIVE=4
# Cases one score replays at once, each on its own stack.
SCORE_MAX_SAMPLES=4

# --- credentials a run profile reads ------------------------------------
# Who solves a run, and who judges its spans, are named profiles in
# tasks-config.yaml (`solve_profiles`, `score_profiles`), chosen with
# `--profile` and `--score-profile` — never this file.
# A profile's `model_env` lists the variables its provider reads; each one
# it names must be set here. Only the profiles you run need theirs, so this
# template is enough for `opencode-v1-deepseek-flash-medium` and
# `react-deepseek-flash-high` as shipped, and needs one more line before a
# `claude` profile will start.
#   anthropic/...                 ANTHROPIC_API_KEY, or ANTHROPIC_AUTH_TOKEN
#                                 for a subscription; the token wins when both
#   openai/...                    OPENAI_API_KEY
#   google/...                    GOOGLE_API_KEY
#   openrouter/...                OPENROUTER_API_KEY
#   openai-api/<service>/<model>  <SERVICE>_API_KEY + <SERVICE>_BASE_URL
#   mockllm/model                 (none)
# A credential here is a real secret, read from this untracked file, so the
# template keeps placeholders. A profile that names a variable missing from
# `.env` fails before the run starts, with the variable's name in the error.
ANTHROPIC_API_KEY=sk-ant-replace_me
# OAuth token of a Claude subscription — the `-subscription` profile's own
# credential, and what Claude Code itself would read.
ANTHROPIC_AUTH_TOKEN=sk-ant-oat-replace_me
OPENCODE_GO_API_KEY=oc_sk_replace_me
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1

# --- the model the score phase is labelled with. It answers nothing, but
# Inspect requires one, and mockllm makes that explicit in the log. -------
BENCH_SCORE_MODEL=mockllm/model
