# Every knob in config.py can be overridden from the environment.
# This file is the tracked template; copy to .env for local overrides.
# NEVER put real secrets here — sample credentials belong in
# <sample-checkout>/.env (untracked).

# host ports are allocated per run from this range
BENCH_PORT_START=8300
BENCH_PORT_END=8499

# container engine
BENCH_DOCKER=docker
BENCH_COMPOSE=compose
STACK_UP_TIMEOUT_S=900

# refuse to tear the stack down after a gate (debugging)
KEEP_STACK=0

# determinism (do not change casually: goldens are captured with these)
# LOCALE / TIMEZONE_ID / VIEWPORT live in config.py on purpose.

# trace_similarity stays "pending" until an oracle is configured
BENCH_TRACE_ORACLE=none
BENCH_TRACE_ORACLE_CMD=
